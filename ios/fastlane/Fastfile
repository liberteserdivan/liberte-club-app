# Mac olmadan GitHub Actions uzerinden TestFlight yukleme
default_platform(:ios)

platform :ios do
  # App Store Connect API anahtarini ortam degiskenlerinden okur
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch('APP_STORE_CONNECT_KEY_ID'),
      issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
      key_filepath: ENV.fetch('APP_STORE_CONNECT_KEY_PATH'),
      duration: 1200,
      in_house: false
    )
  end

  desc 'Imzala, derle ve TestFlight\'a yukle'
  lane :beta do
    api_key = asc_api_key

    setup_ci if ENV['CI']

    # Dagitim sertifikasi ve provisioning profile (Mac gerekmez — API ile olusturulur)
    cert(
      api_key: api_key,
      output_path: './certificates',
      filename: 'liberte_distribution'
    )

    profile_path = sigh(
      api_key: api_key,
      app_identifier: 'cafe.liberte.app',
      output_path: './certificates',
      filename: 'liberte_appstore',
      cert_id: lane_context[SharedValues::CERT_CERTIFICATE_ID]
    )

    update_project_team(
      path: 'App/App.xcodeproj',
      teamid: ENV.fetch('APPLE_TEAM_ID')
    )

    disable_automatic_code_signing(
      path: 'App/App.xcodeproj',
      teamid: ENV.fetch('APPLE_TEAM_ID'),
      targets: ['App']
    )

    update_project_provisioning(
      xcodeproj: 'App/App.xcodeproj',
      target_filter: 'App',
      profile: profile_path,
      code_signing_identity: 'Apple Distribution'
    )

    build_app(
      project: 'App/App.xcodeproj',
      scheme: 'App',
      export_method: 'app-store',
      output_directory: './build',
      output_name: 'Liberte.ipa',
      export_options: {
        provisioningProfiles: {
          'cafe.liberte.app' => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch('IOS_CHANGELOG', 'Liberte Club guncellemesi')
    )
  end
end
