# Vercel / canlı ortam — değerleri Vercel dashboard'dan girin, repoya commit etmeyin.

# PostgreSQL — Supabase (önerilen) veya Neon
# Supabase Vercel: Connection pooling → Transaction → URI (port 6543)
DATABASE_URL=

# Realtime hazırlık — loyalty_events yazımı (varsayılan kapalı)
# ENABLE_LOYALTY_EVENT_LOG=1

# E-posta doğrulama kodu (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Liberte <noreply@liberte.cafe>

# Yönetici paneli PIN (istemciye asla gönderilmez)
ADMIN_PIN=

# QR imza anahtarı — müşteri QR token HMAC (boşsa ADMIN_PIN kullanılır)
QR_SIGNING_SECRET=

# CORS — virgülle ayrılmış (ör. https://app.liberte.cafe)
# Not: Capacitor native kökenleri (https://localhost vb.) kodda otomatik izinlidir.
ALLOWED_ORIGINS=

# Firebase Web (Firebase Console → Proje ayarları → Genel)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Runtime Firebase web config (önerilen — redeploy build gerektirmez)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# Firebase Cloud Messaging → Web Push sertifikası (VAPID public key)
# Build için: VITE_FIREBASE_VAPID_KEY
# Runtime için (önerilen): FIREBASE_VAPID_PUBLIC_KEY
VITE_FIREBASE_VAPID_KEY=
FIREBASE_VAPID_PUBLIC_KEY=

# Firebase Admin — sunucudan push gönderimi (tek satır JSON veya base64)
# Hazırlamak için: node scripts/minify-service-account.mjs indirilen-key.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Codemagic — yerel build tetikleme (scripts/trigger-codemagic.mjs)
# Token: Codemagic → Personal account → Integrations → Codemagic API
# App ID: Codemagic → liberte-club-app → App settings → Application ID
CODEMAGIC_API_TOKEN=
CODEMAGIC_APP_ID=6a27103ffb57938b06e2c701

# Neon taşıma — yedek alma / yükleme (commit etmeyin)
# SOURCE_DATABASE_URL=postgresql://...eski_proje...
# TARGET_DATABASE_URL=postgresql://...yeni_proje...

# Not: Google Cloud Console → API key → HTTP referrer kısıtlarına şunları ekleyin:
# https://app.liberte.cafe/*
# https://*.vercel.app/*
