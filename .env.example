# Vercel / canlı ortam — değerleri Vercel dashboard'dan girin, repoya commit etmeyin.

# PostgreSQL — Production ZORUNLU: Supabase Transaction Pooler (port 6543)
# Örnek host: aws-0-eu-central-1.pooler.supabase.com:6543
# Neon (aws.neon.tech) production'da KULLANILMAMALI — db-status ile doğrulayın
DATABASE_URL=

# Normalize tablo cutover — Production ZORUNLU: 1
# Vercel vercel.json içinde de 1 olarak ayarlı; dashboard ile çakışmayın
USE_RELATIONAL_STATE=1

# Native (iOS/Android) build'in vuracağı API kökü (build-time).
# Web/PWA bunu KULLANMAZ — relative path ile same-origin çalışır.
# Yalnızca https:// kök kabul edilir; boş/geçersizse fallback app.libertegastrocafe.com.
# Domain veya geçici Vercel URL'ine geçişte SADECE bu değeri değiştirip yeni
# mobil build almak gerekir (mevcut cihazlara OTA yansımaz).
VITE_API_BASE_URL=https://app.libertegastrocafe.com

# E-posta doğrulama kodu (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Liberte <noreply@liberte.cafe>

# Yönetici paneli PIN (istemciye asla gönderilmez)
ADMIN_PIN=

# Yerel smoke test — sadece scripts/smoke-admin-members.mjs için (commit etmeyin)
# Alternatif: node scripts/smoke-admin-interactive.mjs (.env gerekmez)
SMOKE_ADMIN_CUSTOMER_PIN=
# SMOKE_ADMIN_PHONE=5058665406

# QR imza anahtarı — müşteri QR token HMAC (boşsa ADMIN_PIN kullanılır)
QR_SIGNING_SECRET=

# Tanılama endpoint'leri (db-status, push-status, qr-status) — production koruması
# Smoke script'ler: header X-Config-Diag veya ?diagSecret=
CONFIG_DIAG_SECRET=

# CORS — virgülle ayrılmış (ör. https://app.libertegastrocafe.com)
# Not: Capacitor native kökenleri (https://localhost vb.) kodda otomatik izinlidir.
ALLOWED_ORIGINS=

# Firebase Web (Firebase Console → Proje ayarları → Genel)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Runtime Firebase web config (önerilen — redeploy build gerektirmez)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# Firebase Cloud Messaging → Web Push sertifikası (VAPID public key)
# Build için: VITE_FIREBASE_VAPID_KEY
# Runtime için (önerilen): FIREBASE_VAPID_PUBLIC_KEY
VITE_FIREBASE_VAPID_KEY=
FIREBASE_VAPID_PUBLIC_KEY=

# Firebase Admin — sunucudan push gönderimi (tek satır JSON veya base64)
# Hazırlamak için: node scripts/minify-service-account.mjs indirilen-key.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Codemagic — yerel build tetikleme (scripts/trigger-codemagic.mjs)
# Token: Codemagic → Personal account → Integrations → Codemagic API
# App ID: Codemagic → liberte-club-app → App settings → Application ID
CODEMAGIC_API_TOKEN=
CODEMAGIC_APP_ID=6a27103ffb57938b06e2c701

# Neon taşıma — yedek alma / yükleme (commit etmeyin)
# SOURCE_DATABASE_URL=postgresql://...eski_proje...
# TARGET_DATABASE_URL=postgresql://...yeni_proje...

# Supabase Realtime (yalnızca anon key — service role ASLA frontend'e konmaz)
# Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Realtime RLS JWT imzası — Dashboard → API → JWT Secret (service role DEĞİL)
SUPABASE_JWT_SECRET=
# Build-time alternatif:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING
# DATABASE_URL_UNPOOLED, DATABASE_URL_NON_POOLING, NEON_DATABASE_URL

# Not: Google Cloud Console → API key → HTTP referrer kısıtlarına şunları ekleyin:
# https://app.libertegastrocafe.com/*
# https://*.vercel.app/*
