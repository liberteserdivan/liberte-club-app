{
  "buildCommand": "npm run build:release",
  "outputDirectory": "dist",
  "env": {
    "USE_RELATIONAL_STATE": "1"
  },
  "functions": {
    "api/admin.js": {
      "maxDuration": 60
    },
    "api/push.js": {
      "maxDuration": 60
    },
    "api/auth.js": {
      "maxDuration": 60
    },
    "api/state.js": {
      "maxDuration": 60
    },
    "api/loyalty.js": {
      "maxDuration": 30
    },
    "api/realtime.js": {
      "maxDuration": 60
    },
    "api/qr.js": {
      "maxDuration": 30
    },
    "api/guardian.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/gizlilik", "destination": "/privacy", "permanent": true },
    { "source": "/kullanim-sartlari", "destination": "/terms", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/health", "destination": "/api/config?resource=warm" },
    { "source": "/api/loyalty/daily-claim", "destination": "/api/loyalty?action=daily-claim" },
    { "source": "/api/auth/login", "destination": "/api/auth?action=login" },
    { "source": "/api/auth/session", "destination": "/api/auth?action=session" },
    { "source": "/api/auth/register-complete", "destination": "/api/auth?action=register-complete" },
    { "source": "/api/auth/forgot-pin", "destination": "/api/auth?action=forgot-pin" },
    { "source": "/api/auth/admin-pin", "destination": "/api/auth?action=admin-pin" },
    { "source": "/api/admin/members", "destination": "/api/auth?action=admin-members" },
    { "source": "/api/backup", "destination": "/api/admin?resource=backup" },
    { "source": "/api/push/send", "destination": "/api/admin?resource=push-send" },
    { "source": "/api/push/register-device", "destination": "/api/push?action=register-device" },
    { "source": "/api/qr/generate", "destination": "/api/qr?action=generate" },
    { "source": "/api/push/cleanup", "destination": "/api/admin?resource=push-cleanup" },
    { "source": "/api/realtime", "destination": "/api/realtime" },
    { "source": "/api/account/delete", "destination": "/api/admin?resource=account-delete" },
    { "source": "/api/guardian/health/:service", "destination": "/api/guardian?resource=health&service=:service" },
    { "source": "/api/guardian/health", "destination": "/api/guardian?resource=health" },
    { "source": "/api/guardian/incidents", "destination": "/api/guardian?resource=incidents" },
    { "source": "/api/guardian/safe-mode", "destination": "/api/guardian?resource=safe-mode" },
    { "source": "/api/guardian/report", "destination": "/api/guardian?resource=report" },
    { "source": "/api/guardian/test-alert", "destination": "/api/guardian?resource=test-alert" },
    { "source": "/api/guardian/metrics", "destination": "/api/guardian?resource=metrics" },
    { "source": "/api/guardian/actions/:id/approve", "destination": "/api/guardian?resource=actions&op=approve&actionId=:id" },
    { "source": "/api/guardian/actions/:id/reject", "destination": "/api/guardian?resource=actions&op=reject&actionId=:id" },
    { "source": "/api/guardian/actions/:id/execute", "destination": "/api/guardian?resource=actions&op=execute&actionId=:id" },
    { "source": "/api/guardian/actions/:id/rollback", "destination": "/api/guardian?resource=actions&op=rollback&actionId=:id" },
    { "source": "/api/guardian/actions/propose", "destination": "/api/guardian?resource=actions&op=propose" },
    { "source": "/api/guardian/actions/:id", "destination": "/api/guardian?resource=actions&actionId=:id" },
    { "source": "/api/guardian/actions", "destination": "/api/guardian?resource=actions" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/support", "destination": "/support.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
