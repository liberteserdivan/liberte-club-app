{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/gizlilik", "destination": "/privacy", "permanent": true },
    { "source": "/kullanim-sartlari", "destination": "/terms", "permanent": true }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/api/logs", "destination": "/api/error-logs" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
