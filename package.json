{
  "name": "liberte-club-app",
  "private": true,
  "version": "1.1.22",
  "description": "Liberte Club — Liberte Gastro Cafe sadakat uygulaması",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-firebase-sw.mjs && vite",
    "test": "node --test tests/*.mjs",
    "lint": "eslint . --max-warnings 9999",
    "codemagic:check": "node scripts/check-codemagic-env.mjs",
    "codemagic:ios": "node scripts/trigger-codemagic.mjs ios-release main",
    "codemagic:android": "node scripts/trigger-codemagic.mjs android-release main",
    "neon:export": "node scripts/export-neon-backup.mjs",
    "neon:import": "node scripts/import-neon-backup.mjs",
    "neon:restore": "node scripts/restore-app-backup.mjs",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate:neon-to-supabase": "node scripts/migrate-neon-to-supabase.mjs",
    "db:cutover-probe": "node scripts/supabase-cutover-probe.mjs",
    "db:apply-rls": "node scripts/apply-rls-phased.mjs",
    "db:apply-rls:phase1": "node scripts/apply-rls-phased.mjs --phase=1",
    "db:apply-rls:phase2": "node scripts/apply-rls-phased.mjs --phase=2",
    "db:apply-rls:phase3": "node scripts/apply-rls-phased.mjs --phase=3",
    "db:rollback-rls:phase1": "node scripts/apply-rls-phased.mjs --rollback=1",
    "db:rollback-rls:phase2": "node scripts/apply-rls-phased.mjs --rollback=2",
    "db:rollback-rls:phase3": "node scripts/apply-rls-phased.mjs --rollback=3",
    "smoke:rls": "node scripts/smoke-rls.mjs",
    "smoke:rls:phase1": "node scripts/smoke-rls-phase1.mjs",
    "smoke:rls:phase2": "node scripts/smoke-rls-phase2.mjs",
    "smoke:rls:phase3": "node scripts/smoke-rls-phase3.mjs",
    "vercel:set-jwt-secret": "node scripts/set-vercel-jwt-secret.mjs",
    "db:verify-supabase": "node scripts/verify-supabase-connection.mjs",
    "build": "node scripts/generate-firebase-sw.mjs && node scripts/generate-pwa-icons.mjs && node scripts/prepare-transparent-logo.mjs && node scripts/generate-splash-assets.mjs && node scripts/generate-ios-assets.mjs && node scripts/generate-android-splash.mjs && node scripts/generate-notification-badge.mjs && node scripts/generate-legal-pages.mjs && vite build && npm test",
    "build:release": "node scripts/generate-firebase-sw.mjs && node scripts/generate-pwa-icons.mjs && node scripts/prepare-transparent-logo.mjs && node scripts/generate-splash-assets.mjs && node scripts/generate-ios-assets.mjs && node scripts/generate-android-splash.mjs && node scripts/generate-notification-badge.mjs && node scripts/generate-legal-pages.mjs && vite build",
    "preview": "vite preview",
    "optimize-cup": "node scripts/optimize-cup-glb.mjs Liberte_Cup_Luwai.glb Liberte_Cup_Luwai_App.glb",
    "import-luwai-cup": "node scripts/import-luwai-cup.mjs",
    "import-meshy-cup": "node scripts/import-meshy-cup.mjs && node scripts/optimize-cup-glb.mjs Liberte_Cup_Meshy.glb",
    "deploy:check": "npm run build",
    "icons:android": "node scripts/generate-android-icons.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:android": "npm run build && npx cap sync android",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "cap:android": "npm run cap:sync:android && cd android && gradlew.bat assembleDebug",
    "cap:ios": "npm run cap:sync:ios && npx cap open ios",
    "release:android": "node scripts/materialize-firebase-native-config.mjs && npm run build && node scripts/generate-android-icons.mjs && npx cap sync android && cd android && gradlew.bat bundleRelease",
    "publish:android": "node scripts/publish-android-play.mjs internal",
    "publish:android:internal": "node scripts/publish-android-play.mjs internal --build",
    "publish:android:production": "node scripts/publish-android-play.mjs production --build",
    "release:android:ship": "node scripts/publish-android-play.mjs internal --build",
    "cap:sync:ios:only": "npx cap sync ios",
    "import:menu": "node scripts/import-menu-from-xlsx.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.1.0",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.108.2",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.10.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.511.0",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.34.5",
    "vite": "^6.0.0"
  }
}
