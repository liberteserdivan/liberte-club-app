{
  "name": "liberte-club-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-firebase-sw.mjs && vite",
    "build": "node scripts/generate-firebase-sw.mjs && vite build",
    "preview": "vite preview",
    "optimize-cup": "node scripts/optimize-cup-glb.mjs Liberte_Cup_Luwai.glb Liberte_Cup_Luwai_App.glb",
    "import-luwai-cup": "node scripts/import-luwai-cup.mjs",
    "import-meshy-cup": "node scripts/import-meshy-cup.mjs && node scripts/optimize-cup-glb.mjs Liberte_Cup_Meshy.glb",
    "deploy:check": "npm run build",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:android": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@neondatabase/serverless": "^1.1.0",
    "firebase": "^11.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.511.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.34.5",
    "vite": "^6.0.0"
  }
}
