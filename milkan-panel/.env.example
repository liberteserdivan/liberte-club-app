# SmartPOS SQL Server — yerel ağ (192.168.1.120)
SMARTPOS_SQL_SERVER=192.168.1.120
SMARTPOS_SQL_DATABASE=SMARTPOSV47
SMARTPOS_SQL_USER=sa
